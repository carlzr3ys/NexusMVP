# Environment — copy to .env and fill in

# PostgreSQL (Neon recommended)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Session signing — use a long random string in production
AUTH_SECRET=change-me-to-a-long-random-string

# Local dev: force brand (deliverred | titan-cargo)
# BRAND_OVERRIDE=deliverred

# Road distance for quotes (free tier: https://openrouteservice.org)
# ORS_API_KEY=

# Email — Resend preferred (verify domain first)
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM="NEXUS <noreply@airee.online>"
# Optional SMTP fallback:
# SMTP_HOST=mail.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=noreply@example.com
# SMTP_PASS=
# OPS_INBOX_EMAIL=ops@example.com
